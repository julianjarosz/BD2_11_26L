# Local development only. Copy this file to `.env` and adjust values locally.

# OpenWeather API
OPENWEATHER_API_KEY=

# Operational PostgreSQL database used by the Python ingestion app.
OPERATIONAL_DB_USER=postgres
OPERATIONAL_DB_PASSWORD=postgres
OPERATIONAL_DB_NAME=weather_operational
OPERATIONAL_DB_PORT=5432

# Warehouse PostgreSQL database used later by ELT jobs.
WAREHOUSE_DB_USER=postgres
WAREHOUSE_DB_PASSWORD=postgres
WAREHOUSE_DB_NAME=weather_warehouse
WAREHOUSE_DB_PORT=5433

# Redis metadata cache.
REDIS_PORT=6379

# pgAdmin local UI.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Airflow local UI.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_PORT=8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=admin@example.com
AIRFLOW_SECRET_KEY=weather-airflow-secret-key
